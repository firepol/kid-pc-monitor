# Kid PC Monitor — local configuration
#
# Copy this file to "config.ini" and edit as needed:
#     cp config.ini.example config.ini
#
# config.ini is gitignored (it is per-machine). Any value you omit — or this
# whole file — falls back to the built-in defaults shown below, so it is
# entirely optional. The installers can also create it for you.

[web]
# Port the agent's web UI listens on, on each kid PC. Open this in a browser
# from any device on your network: http://<kid-pc-ip>:<port>
# The kid sees a read-only "time left" page; the parent logs in at /admin.
# Default: 9999
port = 9999

# Admin login. Set the password hash with scripts/set_password.py (it never
# stores the plain password). Until a password is set, the /admin login is
# disabled. Default username: parent
username = parent
# password_hash =   # set via: python scripts/set_password.py

[limits]
# Daily allowance in minutes. "default" applies to any day not listed below;
# add per-weekday lines to give different days different allowances. The chosen
# allowance auto-applies each day and the usage clock resets; the parent can
# still override it for the current day from the admin page.
default = 120
# How long a scheduled lock holds the screen, in minutes. A bedtime lock should
# stay locked overnight, not just for its triggering minute. Default: 600 (10h).
# lock_duration_minutes = 600
# monday    = 90
# tuesday   = 90
# wednesday = 90
# thursday  = 90
# friday    = 120
saturday  = 240
sunday    = 240

[sounds]
# Name your sound files once here, then refer to them by name below (so you
# don't repeat full paths). Relative paths are resolved against the repo root;
# absolute paths work too.
#
# Formats: .wav always works (no extra software). mp3/opus/ogg/flac/m4a/... work
# if ffmpeg (ffplay) or mpv is on PATH — otherwise non-wav falls back to a beep.
# See the "Sounds" section in the README.
# gentle = sounds/gentle.wav
# bell   = sounds/bell.opus
# urgent = C:\sounds\urgent.mp3

[notifications]
# Warn the kid as time runs low. Instead of a mandatory popup, play a sound at
# each minutes-remaining mark.
sound_enabled = true
popup_enabled = false      # also show an on-screen popup?

# RECOMMENDED — "notify": map each minute mark to a sound name from [sounds]
# above. The minutes listed here ARE the alert thresholds — e.g. alert at 15, 5,
# 2 and 1 minutes left, each with its own sound. A name you leave off (e.g.
# "1:") plays the default sound. Unknown/empty names fall back to sound_file.
notify = 15:gentle, 5:bell, 2:urgent, 1:urgent

# Default/fallback sound, used for any mark whose name is missing or unknown
# (empty = a system beep).
# sound_file = sounds/warning.wav

# LEGACY alternative to "notify": play the single sound_file at each of these
# marks (no per-mark sounds). Ignored whenever "notify" is set above. Kept only
# for older configs — prefer "notify".
# thresholds = 15,5,2,1

[monitoring]
# Restrict who is monitored by OS username. Leave both empty to monitor every
# user. monitored_users = only these are restricted. exempt_users = everyone
# except these (use for parent/admin accounts on a shared PC).
# monitored_users = Tommy, Sara
# exempt_users    = Dad, Mom
# Once-per-day "save your work" window (seconds) granted after the first lock.
grace_period_seconds = 60

[activity]
# Log which program is in the foreground, for the usage history on the admin
# page. Sampled every interval_seconds. Set enabled = false to turn it off.
enabled = true
interval_seconds = 15

[storage]
# SQLite database file (history, activity, live state). Relative paths are
# resolved against the repo root. Default: kidmon.db
db_path = kidmon.db

[chat]
# A simple parent<->kid chat on the status page. The kid sees and replies on
# their own status page; the parent (once logged in) chats from the same page on
# their device and sets their display name there (so Mom and Dad can differ).
enabled = true
# Name shown for the kid in the header and chat. Defaults to the OS username.
# kid_name = Tommy
